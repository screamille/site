---
import Base from "../layouts/Base.astro";
import { OFFRE, BASE } from "../config";
---
<Base title="Commande confirmée (test)" noindex>
  <section>
    <div class="wrap narrow center">
      <p class="banner">🧪 Simulation — aucune commande réelle n'a été enregistrée, aucun paiement n'a eu lieu.</p>
      <h1>Commande reçue ! 🎉</h1>
      <p class="lead">Dans la vraie version, l'accès serait envoyé par e-mail juste après un vrai paiement. En attendant, voici à quoi ressemblera la page d'accès à {OFFRE.nomFormation} :</p>
      <a href={`${BASE}/formation/`} class="btn">Voir la formation</a>
    </div>
  </section>
</Base>

<style>
  .banner { background: #fff7d6; border: 1px dashed #d8b400; border-radius: 10px; padding: 14px 18px; margin-bottom: 32px; display: inline-block; }
</style>
