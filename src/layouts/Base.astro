---
import { SITE } from "../config";
interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = SITE.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.nom}` : `${SITE.nom} — ${SITE.accroche}`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={new URL(Astro.url.pathname, SITE.url)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <header class="top">
    <div class="wrap top-in">
      <a href="/" class="logo"><span class="logo-mark">✦</span> {SITE.nom}</a>
      <nav>
        <a href="/gratuit">Cadeau gratuit</a>
        <a href="/#prix" class="btn btn-sm">Rejoindre</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="foot">
    <div class="wrap foot-in">
      <p>© {year} {SITE.nom}</p>
      <nav>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/cgv">CGV</a>
        <a href="/confidentialite">Confidentialité</a>
        <a href={`mailto:${SITE.email}`}>Contact</a>
      </nav>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --ink: #17212b;
    --muted: #5b6672;
    --bg: #fbfaf7;
    --card: #ffffff;
    --line: #e7e3da;
    --accent: #e0592a;
    --accent-dark: #c2461b;
    --soft: #fff1ea;
    --radius: 14px;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 17px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  h1, h2, h3 { line-height: 1.2; letter-spacing: -0.01em; margin: 0 0 .6em; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.3rem); }
  h3 { font-size: 1.2rem; }
  p { margin: 0 0 1em; }
  a { color: var(--accent-dark); }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  .narrow { max-width: 760px; }
  section { padding: 72px 0; }
  .alt { background: var(--card); border-block: 1px solid var(--line); }
  .eyebrow { text-transform: uppercase; font-size: .8rem; letter-spacing: .12em; color: var(--accent-dark); font-weight: 700; margin-bottom: .8em; }
  .lead { font-size: 1.2rem; color: var(--muted); }
  .center { text-align: center; }
  .btn {
    display: inline-block; background: var(--accent); color: #fff; text-decoration: none;
    font-weight: 700; padding: 15px 28px; border-radius: 999px; border: 0; cursor: pointer;
    font-size: 1.05rem; transition: background .15s, transform .15s;
  }
  .btn:hover { background: var(--accent-dark); transform: translateY(-1px); }
  .btn-sm { padding: 8px 18px; font-size: .95rem; }
  .btn-ghost { background: transparent; color: var(--ink); border: 2px solid var(--ink); }
  .btn-ghost:hover { background: var(--ink); color: #fff; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .top { position: sticky; top: 0; z-index: 10; background: rgba(251,250,247,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .top-in { display: flex; justify-content: space-between; align-items: center; height: 64px; gap: 12px; }
  .top nav { display: flex; align-items: center; gap: 18px; }
  .top nav a:not(.btn) { color: var(--ink); text-decoration: none; font-weight: 600; font-size: .95rem; }
  .logo { font-weight: 800; color: var(--ink); text-decoration: none; font-size: 1.1rem; white-space: nowrap; }
  .logo-mark { color: var(--accent); }
  .foot { padding: 32px 0; color: var(--muted); font-size: .9rem; }
  .foot-in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .foot nav { display: flex; flex-wrap: wrap; gap: 16px; }
  .foot a { color: var(--muted); }
  input[type=email], input[type=text] {
    width: 100%; padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; font: inherit; background: #fff;
  }
  .legal h2 { font-size: 1.3rem; margin-top: 1.6em; }
  .todo { background: #fff7d6; border: 1px dashed #d8b400; padding: 2px 6px; border-radius: 4px; }
  @media (max-width: 560px) {
    section { padding: 52px 0; }
    .top nav a:not(.btn) { display: none; }
  }
</style>
